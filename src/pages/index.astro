---
import BaseLayout from '../layouts/BaseLayout.astro';
import { STUDIO_CONFIG } from '../data/studio';
---

<BaseLayout title="NiK Studio — Dark Liquid Glass • iOS & Music" active="home">
  <!-- Hero Frosted Glass -->
  <section class="liquid-glass rounded-[2rem] p-6 sm:p-10 md:p-14 overflow-hidden mb-8">
    <div class="absolute inset-0 -z-10 opacity-25">
      <img src={STUDIO_CONFIG.assets.hero} alt="NiK Studio" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-[#05070e] via-[#05070e]/70 to-transparent"></div>
    </div>

    <div class="max-w-3xl">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-medium bg-white/10 border border-white/20 text-cyan-200 shadow-[inset_0_1px_0_rgba(255,255,255,0.25)]">
        <span class="w-2 h-2 rounded-full bg-cyan-400 shadow-[0_0_8px_rgba(34,211,238,0.9)]"></span>
        <span class="i18n-text" data-vi="STUDIO ĐỘC LẬP • CÔNG CỤ iOS & ÂM NHẠC" data-en="INDEPENDENT STUDIO • iOS TOOLS & MUSIC">
          STUDIO ĐỘC LẬP • CÔNG CỤ iOS & ÂM NHẠC
        </span>
      </span>

      <h1 class="mt-5 text-3xl sm:text-5xl font-bold tracking-tight text-white leading-[1.12] i18n-text"
          data-vi="Kiến tạo phần mềm iOS tinh giản & trải nghiệm âm nhạc cảm xúc."
          data-en="Crafting refined iOS utilities & expressive music experiences.">
        Kiến tạo phần mềm iOS tinh giản & trải nghiệm âm nhạc cảm xúc.
      </h1>

      <p class="mt-4 text-sm sm:text-base text-slate-300 max-w-2xl leading-relaxed i18n-text"
         data-vi="Khám phá hệ sinh thái NiK Studio với XSign iOS v1.0.0 theo phong cách Dark Liquid Glass cùng các bản remix độc quyền."
         data-en="Explore the NiK Studio ecosystem featuring XSign iOS v1.0.0 in Dark Liquid Glass style alongside exclusive remixes.">
        Khám phá hệ sinh thái NiK Studio với XSign iOS v1.0.0 theo phong cách Dark Liquid Glass cùng các bản remix độc quyền.
      </p>

      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/xsign" class="liquid-btn-primary px-6 py-3 rounded-2xl text-sm font-semibold text-white inline-flex items-center gap-2">
          <span class="i18n-text" data-vi="Khám phá XSign v1.0.0" data-en="Explore XSign v1.0.0">Khám phá XSign v1.0.0</span>
          <span>→</span>
        </a>
        <a href="/contact" class="liquid-btn px-6 py-3 rounded-2xl text-sm font-semibold text-white inline-flex items-center gap-2">
          <span class="i18n-text" data-vi="Liên hệ" data-en="Contact">Liên hệ</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Bento Grid Products -->
  <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- XSign Featured Card -->
    <a href="/xsign" class="liquid-glass rounded-[2rem] p-5 sm:p-7 group hover:border-cyan-300/40 transition-all flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between gap-3 mb-4">
          <span class="px-3 py-1 rounded-full text-xs font-semibold bg-emerald-400/15 text-emerald-300 border border-emerald-400/30 i18n-text"
                data-vi="Đã phát hành" data-en="Released">
            Đã phát hành
          </span>
          <span class="text-xs font-mono text-cyan-200/90 bg-white/10 px-2.5 py-1 rounded-full border border-white/15">
            {STUDIO_CONFIG.xsign.version}
          </span>
        </div>

        <div class="rounded-2xl overflow-hidden border border-white/15 bg-black/30 aspect-[16/10] mb-5">
          <img
            src={STUDIO_CONFIG.assets.xsign}
            alt="XSign iOS v1.0.0"
            class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500"
          />
        </div>
      </div>

      <div class="flex items-end justify-between gap-4">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-white group-hover:text-cyan-200 transition-colors">
            XSign iOS {STUDIO_CONFIG.xsign.version}
          </h2>
          <p class="mt-1.5 text-sm text-slate-300 i18n-text"
             data-vi="Công cụ ký & cài đặt IPA trực tiếp trên iPhone với giao diện Liquid Glass, Dynamic Island & AltSource."
             data-en="On-device IPA signing & installation utility for iPhone with Liquid Glass UI, Dynamic Island & AltSource.">
            Công cụ ký & cài đặt IPA trực tiếp trên iPhone với giao diện Liquid Glass, Dynamic Island & AltSource.
          </p>
        </div>
        <span class="shrink-0 w-10 h-10 rounded-full liquid-btn flex items-center justify-center text-white group-hover:translate-x-1 transition-transform">
          →
        </span>
      </div>
    </a>



      <!-- VIX / VIX MAX (In Development, non-product link) -->
      <div class="liquid-glass rounded-[2rem] p-5 sm:p-7 opacity-90 flex flex-col justify-center gap-6">
        <div class="flex items-center justify-between gap-3 mb-4">
          <span class="px-3 py-1 rounded-full text-xs font-semibold bg-amber-400/15 text-amber-200 border border-amber-400/30 i18n-text"
                data-vi="Đang phát triển" data-en="In Development">
            Đang phát triển
          </span>
          <span class="text-xs font-mono text-slate-400">DSP / VST3</span>
        </div>

        <div class="flex items-center gap-4">
          <img src={STUDIO_CONFIG.assets.vix} alt="VIX / VIX MAX" class="w-20 h-20 rounded-2xl object-cover border border-white/15 grayscale-[30%] shrink-0" />
          <div>
            <h2 class="text-lg sm:text-xl font-bold text-white">VIX / VIX MAX</h2>
            <p class="mt-1 text-xs sm:text-sm text-slate-400 i18n-text"
               data-vi="Plugin xử lý giọng hát DSP thế hệ mới. Hiện đang được tạm ẩn để nâng cấp."
               data-en="Next-gen DSP vocal processing plugin. Currently in development.">
              Plugin xử lý giọng hát DSP thế hệ mới. Hiện đang được tạm ẩn để nâng cấp.
            </p>
          </div>
        </div>
      </div>
  </section>
</BaseLayout>
