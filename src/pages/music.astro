---
import BaseLayout from '../layouts/BaseLayout.astro';
import { STUDIO_CONFIG } from '../data/studio';
---
<BaseLayout title="Music — NiK Studio" active="music">
  <section class="space-y-8">
    <div class="space-y-3">
      <div class="liquid-glass-pill inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-medium text-purple-300">
        <span class="w-2 h-2 rounded-full bg-purple-400"></span>
        <span class="i18n-text" data-vi="Âm nhạc & Hình ảnh" data-en="Music & Visuals">Âm nhạc & Hình ảnh</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
        <span class="i18n-text" data-vi="Dự án Âm nhạc" data-en="Music Projects">Dự án Âm nhạc</span>
      </h1>
      <p class="text-slate-300 max-w-2xl text-sm sm:text-base">
        <span class="i18n-text" data-vi="Các bản phối nhạc điện tử, thử nghiệm âm thanh và trình chiếu pixel 16-bit tại NiK Studio." data-en="Electronic remixes, sound experiments, and 16-bit pixel visualizer projects by NiK Studio.">Các bản phối nhạc điện tử, thử nghiệm âm thanh và trình chiếu pixel 16-bit tại NiK Studio.</span>
      </p>
    </div>

    <div class="liquid-glass rounded-3xl p-6 sm:p-8 grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
      <div class="relative group">
        <img
          src={STUDIO_CONFIG.assets.music}
          alt="La La Love On My Mind (138 BPM Remix)"
          class="w-full rounded-2xl aspect-square object-cover border border-white/15 shadow-2xl"
        />
      </div>

      <div class="md:col-span-2 space-y-5">
        <div class="flex flex-wrap items-center gap-2">
          <span class="liquid-glass-pill px-3 py-1 rounded-full text-xs font-semibold text-sky-300">138 BPM</span>
          <span class="liquid-glass-pill px-3 py-1 rounded-full text-xs font-medium text-slate-300">
            <span class="i18n-text" data-vi="Bản phối Remix" data-en="Remix Track">Bản phối Remix</span>
          </span>
        </div>

        <div class="space-y-2">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white">
            La La Love On My Mind (138 BPM Remix)
          </h2>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            <span class="i18n-text" data-vi="Dự án nhạc điện tử kết hợp trình chiếu pixel 16-bit với nhịp độ 138 BPM sôi động." data-en="Electronic music & 16-bit pixel visualizer project running at an energetic 138 BPM.">Dự án nhạc điện tử kết hợp trình chiếu pixel 16-bit với nhịp độ 138 BPM sôi động.</span>
          </p>
        </div>

        {STUDIO_CONFIG.audio.musicTrack ? (
          <div class="liquid-glass-pill rounded-2xl p-4 space-y-2">
            <p class="text-xs font-medium text-slate-300">
              <span class="i18n-text" data-vi="Nghe bản phối trực tiếp" data-en="Listen to the track">Nghe bản phối trực tiếp</span>
            </p>
            <audio controls src={STUDIO_CONFIG.audio.musicTrack} class="w-full"></audio>
          </div>
        ) : (
          <div class="liquid-glass-pill rounded-2xl p-4 border border-amber-400/20 space-y-1">
            <p class="text-xs font-semibold text-amber-300">
              <span class="i18n-text" data-vi="Chưa có tệp âm thanh" data-en="Audio Track Not Configured">Chưa có tệp âm thanh</span>
            </p>
            <p class="text-xs font-mono text-slate-400">
              <span class="i18n-text" data-vi="Đặt file .mp3/.wav vào public/audio/ và cập nhật STUDIO_CONFIG.audio.musicTrack trong src/data/studio.ts" data-en="Place a .mp3/.wav file in public/audio/ and update STUDIO_CONFIG.audio.musicTrack in src/data/studio.ts">Đặt file .mp3/.wav vào public/audio/ và cập nhật STUDIO_CONFIG.audio.musicTrack trong src/data/studio.ts</span>
            </p>
          </div>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
