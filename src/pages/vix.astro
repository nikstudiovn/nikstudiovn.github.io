---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="VIX VST3 — NiK Studio" active="vix">
  <section class="min-h-[65vh] flex items-center justify-center">
    <div class="liquid-glass rounded-3xl p-8 sm:p-12 max-w-2xl w-full text-center space-y-6">
      <div class="liquid-glass-pill inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold text-amber-300">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        <span class="i18n-text" data-vi="Đang phát triển" data-en="In Development">Đang phát triển</span>
      </div>

      <div class="space-y-3">
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
          VIX / VIX MAX
        </h1>
        <p class="text-base sm:text-lg text-slate-300 max-w-xl mx-auto leading-relaxed">
          <span class="i18n-text" data-vi="Plugin xử lý giọng hát thế hệ mới (C++ / JUCE & Faust DSP) hiện đang được hoàn thiện. Hãy quay lại sau để trải nghiệm bản phát hành chính thức." data-en="Our next-generation vocal processing VST3 plugin (C++ / JUCE & Faust DSP) is currently under active development. Check back soon for the official release.">Plugin xử lý giọng hát thế hệ mới (C++ / JUCE & Faust DSP) hiện đang được hoàn thiện. Hãy quay lại sau để trải nghiệm bản phát hành chính thức.</span>
        </p>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <a href="/" class="liquid-btn inline-flex items-center justify-center gap-2 px-6 py-3 rounded-2xl text-sm font-semibold text-slate-200">
          <span aria-hidden="true">←</span>
          <span class="i18n-text" data-vi="Quay lại Trang chủ" data-en="Back to Home">Quay lại Trang chủ</span>
        </a>
        <a href="/xsign" class="liquid-btn-primary inline-flex items-center justify-center gap-2 px-6 py-3 rounded-2xl text-sm font-semibold text-white">
          <span class="i18n-text" data-vi="Xem XSign" data-en="Explore XSign">Xem XSign</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
