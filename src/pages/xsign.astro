---
import BaseLayout from '../layouts/BaseLayout.astro';
import { STUDIO_CONFIG } from '../data/studio';

const features = [
  {
    icon: '🎨',
    viTitle: 'Liquid Glass 7 màu icon',
    enTitle: 'Liquid Glass 7 Icon Colors',
    viDesc: 'Giao diện kính mờ iOS 26 tinh tế cùng 7 tùy chọn màu biểu tượng ứng dụng độc đáo.',
    enDesc: 'Refined iOS 26 frosted glass interface with 7 customizable app icon color themes.',
  },
  {
    icon: '🏝️',
    viTitle: 'Dynamic Island 6 chế độ',
    enTitle: 'Dynamic Island 6 Modes',
    viDesc: 'Hiển thị tiến trình ký, tải và cài đặt trực tiếp sống động trên Dynamic Island.',
    enDesc: 'Live signing, downloading, and installation progress across 6 Dynamic Island modes.',
  },
  {
    icon: '📶',
    viTitle: 'Cài trực tiếp 4G/5G Semi Local',
    enTitle: 'Direct 4G/5G Semi Local Install',
    viDesc: 'Cài đặt IPA trực tiếp qua kết nối di động 4G/5G ổn định không cần máy tính.',
    enDesc: 'Install signed IPAs directly over 4G/5G mobile data without a computer.',
  },
  {
    icon: '🌐',
    viTitle: 'Chuyển ngôn ngữ VI/EN tức thì',
    enTitle: 'Instant VI/EN Language Switch',
    viDesc: 'Hỗ trợ song ngữ Tiếng Việt & Tiếng Anh đầy đủ, chuyển đổi ngay lập tức.',
    enDesc: 'Full Vietnamese & English localization with instant in-app switching.',
  },
  {
    icon: '🗂️',
    viTitle: 'Quản lý tệp & Dọn dẹp bộ nhớ',
    enTitle: 'File Manager & Storage Cleaner',
    viDesc: 'Quản lý kho IPA, chứng chỉ, tệp tạm và giải phóng dung lượng nhanh chóng.',
    enDesc: 'Organize IPAs, certificates, temporary files, and reclaim device storage.',
  },
  {
    icon: '⚡',
    viTitle: 'Ký hàng loạt / Presets / Kiểm tra OCSP',
    enTitle: 'Batch Signing / Presets / OCSP Check',
    viDesc: 'Ký nhiều ứng dụng cùng lúc, lưu cấu hình Presets và kiểm tra trạng thái OCSP.',
    enDesc: 'Sign multiple apps in batch, reuse custom presets, and verify certificate OCSP status.',
  },
];
---

<BaseLayout title={`XSign ${STUDIO_CONFIG.xsign.version} — NiK Studio`} active="xsign">
  <!-- Hero & Cover -->
  <section class="liquid-glass rounded-[2rem] p-6 sm:p-10 mb-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-6">
        <div class="flex flex-wrap items-center gap-2.5 mb-4">
          <span class="px-3 py-1 rounded-full text-xs font-semibold bg-emerald-400/15 text-emerald-300 border border-emerald-400/30 i18n-text"
                data-vi="Đã phát hành" data-en="Released">
            Đã phát hành
          </span>
          <span class="px-3 py-1 rounded-full text-xs font-mono text-cyan-200 bg-white/10 border border-white/15">
            {STUDIO_CONFIG.xsign.version}
          </span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-white">XSign iOS</h1>
        <p class="mt-3 text-sm sm:text-base text-slate-300 leading-relaxed i18n-text"
           data-vi="Trình ký và cài đặt ứng dụng IPA thế hệ mới dành cho iPhone & iPad với thiết kế Dark Liquid Glass, Dynamic Island và AltSource."
           data-en="Next-generation on-device IPA signer and installer for iPhone & iPad featuring Dark Liquid Glass UI, Dynamic Island, and AltSource.">
          Trình ký và cài đặt ứng dụng IPA thế hệ mới dành cho iPhone & iPad với thiết kế Dark Liquid Glass, Dynamic Island và AltSource.
        </p>

        <!-- 4 Action Buttons -->
        <div class="mt-7 grid grid-cols-1 sm:grid-cols-2 gap-3">
          <a href={STUDIO_CONFIG.xsign.releaseUrl} target="_blank" rel="noopener noreferrer"
             class="liquid-btn-primary px-5 py-3.5 rounded-2xl text-sm font-semibold text-white flex items-center justify-center gap-2">
            <span>⬇️</span>
            <span class="i18n-text" data-vi="Tải XSign v1.0.0 (.ipa)" data-en="Download XSign v1.0.0 (.ipa)">
              Tải XSign v1.0.0 (.ipa)
            </span>
          </a>

          <button id="copyAltSourceBtn" type="button" data-url={STUDIO_CONFIG.xsign.altSourceUrl}
                  class="liquid-btn px-5 py-3.5 rounded-2xl text-sm font-semibold text-cyan-100 flex items-center justify-center gap-2 cursor-pointer">
            <span>📋</span>
            <span id="copyAltSourceText" class="i18n-text" data-vi="Sao chép & Mở AltSource" data-en="Copy & Open AltSource">
              Sao chép & Mở AltSource
            </span>
          </button>

          <a href={STUDIO_CONFIG.xsign.repoUrl} target="_blank" rel="noopener noreferrer"
             class="liquid-btn px-5 py-3 rounded-2xl text-sm font-medium text-white flex items-center justify-center gap-2">
            <span>GitHub</span>
            <span class="text-slate-400">↗</span>
          </a>

          <a href={STUDIO_CONFIG.socials.telegram} target="_blank" rel="noopener noreferrer"
             class="liquid-btn px-5 py-3 rounded-2xl text-sm font-medium text-white flex items-center justify-center gap-2">
            <span>Telegram @nikvn21</span>
            <span class="text-slate-400">↗</span>
          </a>
        </div>
      </div>

      <div class="lg:col-span-6">
        <div class="rounded-3xl overflow-hidden border border-white/20 bg-black/40 shadow-2xl">
          <img src={STUDIO_CONFIG.assets.xsign} alt="XSign 3D 4K Cover" class="w-full h-auto object-cover" />
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Specs Bar -->
  <section class="liquid-glass rounded-3xl px-6 py-4 mb-8 flex flex-wrap items-center justify-between gap-4 text-xs sm:text-sm">
    <div class="flex items-center gap-2">
      <span class="text-slate-400">Bundle ID:</span>
      <code class="px-2.5 py-1 rounded-lg bg-white/10 text-cyan-200 font-mono">{STUDIO_CONFIG.xsign.bundleId}</code>
    </div>
    <div class="flex items-center gap-2">
      <span class="text-slate-400">URL Scheme:</span>
      <code class="px-2.5 py-1 rounded-lg bg-white/10 text-purple-200 font-mono">{STUDIO_CONFIG.xsign.urlScheme}</code>
    </div>
    <div class="flex items-center gap-2">
      <span class="text-slate-400 i18n-text" data-vi="Phiên bản:" data-en="Version:">Phiên bản:</span>
      <code class="px-2.5 py-1 rounded-lg bg-white/10 text-emerald-300 font-mono">{STUDIO_CONFIG.xsign.version}</code>
    </div>
  </section>

  <!-- 6 Glass Feature Cards -->
  <section>
    <h2 class="text-xl sm:text-2xl font-bold text-white mb-5 i18n-text" data-vi="Tính năng nổi bật" data-en="Key Features">
      Tính năng nổi bật
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {features.map((f) => (
        <div class="liquid-glass rounded-3xl p-6 hover:border-cyan-300/35 transition-all">
          <div class="w-11 h-11 rounded-2xl bg-white/10 border border-white/20 flex items-center justify-center text-xl mb-4">
            {f.icon}
          </div>
          <h3 class="text-base sm:text-lg font-semibold text-white i18n-text" data-vi={f.viTitle} data-en={f.enTitle}>
            {f.viTitle}
          </h3>
          <p class="mt-2 text-xs sm:text-sm text-slate-300 leading-relaxed i18n-text" data-vi={f.viDesc} data-en={f.enDesc}>
            {f.viDesc}
          </p>
        </div>
      ))}
    </div>
  </section>

  <script is:inline>
    (function () {
      const btn = document.getElementById('copyAltSourceBtn');
      const label = document.getElementById('copyAltSourceText');
      if (btn) {
        btn.addEventListener('click', async () => {
          const url = btn.getAttribute('data-url');
          if (!url) return;
          try {
            await navigator.clipboard.writeText(url);
            if (label) {
              const isEn = document.documentElement.lang === 'en';
              label.textContent = isEn ? 'Copied! Opening...' : 'Đã sao chép! Đang mở...';
            }
          } catch {}
          window.open(url, '_blank', 'noopener,noreferrer');
        });
      }
    })();
  </script>
</BaseLayout>
